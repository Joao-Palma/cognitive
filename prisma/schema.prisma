generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // ligação com pooling (runtime)
  directUrl = env("DATABASE_URL_UNPOOLED") // ligação direta (migrações)
}

// ---------- Currículo (Fénix) ----------

model Course {
  id            String    @id @default(cuid())
  fenixId       String    @unique
  acronym       String
  name          String
  nameEn        String? // nome em inglês (Fénix, lang=en-GB)
  ects          Float     @default(6)
  semester      Int?
  programRaw    String?
  lastScrapedAt DateTime?
  topics        Topic[]
  exams         Exam[]
}

model Topic {
  id         String       @id @default(cuid())
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order      Int
  title      String
  titleEn    String? // tradução (os programas do Fénix só existem em português)
  weight     Float        @default(1)
  difficulty Int          @default(2) // 1–3
  estHours   Float?
  tasks      StudyTask[]
  guide      StudyGuide?

  @@unique([courseId, order])
}

model StudyGuide {
  id      String @id @default(cuid())
  topicId String @unique
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content String // markdown — premium
}

// ---------- Utilizador ----------

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image            String?
  isPremium        Boolean         @default(false)
  dailyHours       Float           @default(4)
  studyWindowStart String          @default("09:00")
  studyWindowEnd   String          @default("23:00")
  timezone         String          @default("Europe/Lisbon")
  accounts         Account[]
  sessions         Session[]
  exams            Exam[]
  events           CalendarEvent[]
}

// ---------- Exames, calendário e plano ----------

model Exam {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id])
  datetime       DateTime
  durationMin    Int         @default(180)
  lastTopicOrder Int
  startDate      DateTime?
  status         String      @default("ok") // ok | compressed | infeasible
  missingHours   Float       @default(0)
  tasks          StudyTask[]
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  category    String   @default("outro") // aula | pessoal | trabalho | outro
  blocksStudy Boolean  @default(true)
  rrule       String? // ex: FREQ=WEEKLY;BYDAY=MO,WE;UNTIL=20270131T235959Z
  exdates     String   @default("[]") // JSON array de ISO datetimes (texto, compatível com qualquer BD)
}

model StudyTask {
  id      String   @id @default(cuid())
  examId  String
  exam    Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  topicId String? // null = revisão
  topic   Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  day     DateTime // meia-noite UTC do dia (YYYY-MM-DD)
  hours   Float
  part    Int      @default(1)
  parts   Int      @default(1)
  done    Boolean  @default(false)
}

// ---------- Auth.js ----------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
