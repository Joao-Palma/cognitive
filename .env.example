# Postgres local (docker compose up -d). Na Vercel vêm da integração Neon.
DATABASE_URL="postgresql://estudo:estudo@localhost:5433/estudo"
DATABASE_URL_UNPOOLED="postgresql://estudo:estudo@localhost:5433/estudo"
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="gera-um-com: openssl rand -base64 32"
# Login só com email (sem verificação) está ativo em dev. Em produção: ALLOW_EMAIL_ONLY_LOGIN="true"
# Login por email com magic link (opcional): requer SMTP
# EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
# EMAIL_FROM="Estudo LEIC <no-reply@example.com>"
# Login com Google (opcional, só identificação)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# Emails com acesso a editar pesos/dificuldades dos tópicos (separados por vírgula).
# Em dev, se estiver vazio, todos são admin.
# ADMIN_EMAILS="admin@example.com"
